# Required
OPENAI_API_KEY=
OPENAI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# Everything below is optional. The values shown are the defaults in the code;
# uncomment a line only to change it.

# Database location; default = a local SQLite file (used from Phase 2).
# DATABASE_URL=

# Voice. Unset model = ElevenLabs' default dialogue model; try eleven_v4.
# ELEVENLABS_DIALOGUE_MODEL=eleven_v3
# Only 0.0 (expressive), 0.5 (balanced) or 1.0 (stable)
# ELEVENLABS_DIALOGUE_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75

# Cost estimates (USD). ElevenLabs per 1k chars: v3 0.08, Flash 0.04
# OPENAI_PRICE_INPUT_PER_1M=0.75
# OPENAI_PRICE_OUTPUT_PER_1M=4.50
# ELEVENLABS_PRICE_PER_1K_CHARS=0.08
