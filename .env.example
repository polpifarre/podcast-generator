# Required
OPENAI_API_KEY=
# An OpenAI model that supports structured output, e.g. gpt-5.4-mini-2026-03-17
OPENAI_MODEL=
ELEVENLABS_API_KEY=
# Two voice IDs from your ElevenLabs voice library: host A (Alex) and host B (Sam)
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# Recommended: the dialogue model used for the sample (unset = ElevenLabs' default, eleven_v3)
ELEVENLABS_DIALOGUE_MODEL=eleven_v4

# Everything below is optional. The values shown are the defaults in the code;
# uncomment a line only to change it.

# Database location; default = podcast.db at the repo root.
# DATABASE_URL=

# Voice settings.
# Stability: 0.0 = most expressive, 0.5 = balanced, 1.0 = most stable
# ELEVENLABS_DIALOGUE_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75

# Cost estimates (USD). ElevenLabs per 1k chars: v3 0.08, Flash 0.04
# OPENAI_PRICE_INPUT_PER_1M=0.75
# OPENAI_PRICE_OUTPUT_PER_1M=4.50
# ELEVENLABS_PRICE_PER_1K_CHARS=0.08
